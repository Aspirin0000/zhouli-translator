# 本地 Wrangler/Cloudflare Worker 开发变量。
# 复制为 .dev.vars 后填写，不要提交 .dev.vars。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
MAX_OUTPUT_TOKENS=720
ANALYTICS_ENABLED=false
FEEDBACK_UI_ENABLED=false
CASE_SUBMISSION_ENABLED=false
AB_TEST_ENABLED=false
AB_TEST_B_PERCENT=50
PROMPT_VERSION_A=zhouli-v1
PROMPT_VERSION_B=zhouli-v2
RESPONSE_FEEDBACK_SECRET=replace-with-a-random-server-secret
