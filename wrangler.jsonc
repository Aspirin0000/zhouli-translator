{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhouli-translator",
  "workers_dev": true,
  "preview_urls": true,
  "main": ".open-next/worker.js",
  "routes": [
    {
      "pattern": "hehuzhouli.com",
      "custom_domain": true
    },
    {
      "pattern": "www.hehuzhouli.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-06-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "zhouli-analytics",
      "database_id": "82c06753-d9f2-42bf-82db-91f820e72e84",
      "migrations_dir": "./migrations"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zhouli-translator"
    }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "MAX_OUTPUT_TOKENS": "720",
    "ANALYTICS_ENABLED": "true",
    "FEEDBACK_UI_ENABLED": "true",
    "CASE_SUBMISSION_ENABLED": "true",
    "AB_TEST_ENABLED": "true",
    "AB_TEST_B_PERCENT": "50",
    "PROMPT_VERSION_A": "zhouli-v1",
    "PROMPT_VERSION_B": "zhouli-v3"
  }
}
